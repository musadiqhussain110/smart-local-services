{
  "name": "serviceshub-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @serviceshub/web dev\" \"pnpm --filter @serviceshub/api dev\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
